{"nodes": [{"id": "docs_iphone_house_control_app", "label": "House Control iOS App", "file_type": "image", "source_file": "docs/iphone.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-panel marketing/product mockup of the iPhone companion app: a dark, ambient smart-home controller that mirrors a 3D floor plan and drives lights, AC and TV backlight, paired with a Mac app that owns floor-plan authoring."}, {"id": "docs_iphone_home_overview_screen", "label": "Home Overview Screen", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 1 (leftmost phone)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-screen control hub: 3D floor plan on top half, scene presets and room filters in the middle, device cards at the bottom. Layout decision puts spatial context (which lamp is where) above the flat device list so toggle effects are immediately visible in the scene."}, {"id": "docs_iphone_status_header", "label": "Home Status Header (6 of 11 lights on \u00b7 AC 23\u00b0)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 1, top bar", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact aggregate status line with home picker on the left and a global power button on the right, giving whole-home state without scrolling."}, {"id": "docs_iphone_floor_plan_3d_scene", "label": "3D Isometric Floor Plan Render", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panels 1-3, upper half", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isometric, dimly rendered apartment whose lamps glow warm when on. Doubles as an ambient mood visual and as a spatial index into the device list below; changes across panels show live preview of the selected light."}, {"id": "docs_iphone_scene_presets", "label": "Scene Presets (Bright, Cozy, Movie, Night, Away)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 1, row below floor plan", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five named moods as icon+label chips; 'Cozy' is selected with a blue-outlined pill, making the active scene a single tap to change for the whole home."}, {"id": "docs_iphone_room_filter_chips", "label": "Room Filter Chips (All, Living 2, Dining 1, Kitchen 1)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 1, below scene row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amber count badges show how many lights are on per room, so room-level state is legible before drilling in."}, {"id": "docs_iphone_whole_home_actions", "label": "Whole Home \u00b7 All On / All Off", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 1, list section header", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_iphone_lighting_control_cards", "label": "Lighting Control Cards (Living AC, Ceiling, Floor lamp, TV backlight)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 1, Living section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounded cards combining icon, name, sub-state and inline actions (stepper, power). Active lights get a warm amber tint plus glow; inactive cards stay neutral dark - state is encoded by color, not only by toggle position."}, {"id": "docs_iphone_living_ac_detail_screen", "label": "Living AC Detail Screen", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drill-down for one device: oversized current value (23\u00b0C) as the focal point, power toggle top-right, secondary modalities below. Keeps the floor plan visible instead of a full-screen takeover."}, {"id": "docs_iphone_temperature_slider", "label": "Temperature Slider (16\u00b0-30\u00b0) with Minus/Plus", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 2, centre", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue gradient fill with a large draggable thumb plus redundant -/+ buttons for precise, one-handed adjustment."}, {"id": "docs_iphone_eco_mode_toggle", "label": "Eco Mode Toggle", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 2, right of temperature", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_iphone_ac_feature_dials", "label": "AC Feature Dials (Mode Cool, Fan Auto, Sleep Off, Airflow Swing)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 2, bottom row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each secondary setting is a stacked card: small icon, current value, chevron for a picker. Ambient dot indicators mark settings that are actively non-default (fan and sleep show status dots)."}, {"id": "docs_iphone_tv_backlight_detail_screen", "label": "TV Backlight Detail Screen", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same detail pattern applied to a light: emphasis on brightness percentage, then color. Deliberately consistent skeleton (back, name, status, power, big value, sliders, options) across device types, so users learn one screen shape."}, {"id": "docs_iphone_brightness_slider", "label": "Brightness Slider (70%)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 3, centre", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fill color is the light's own current color (warm amber here), so the control previews the emitted light rather than using a generic accent."}, {"id": "docs_iphone_colour_picker", "label": "Colour Picker with Hex Readout and Swatches (#FF7A3C)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 3, lower half", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saturation/value wheel plus a row of eight preset swatches and an exact hex value - covers both quick mood picking and precise color matching."}, {"id": "docs_iphone_settings_sheet", "label": "Settings Sheet (modal)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presented as a near-full-height bottom sheet with grabber and a 'Done' button rather than a pushed screen; settings is a modal destination that returns to the same home state."}, {"id": "docs_iphone_home_switcher", "label": "Home Switcher (Apartment / Studio demo homes)", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 4, HOME section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parallel implementations of the same pattern in code: multi-home support where each entry is a home with room count and a demo/simulated marker. Selected home uses a filled check circle while the alternate uses an empty radio ring. The selected entry is the 5-room Apartment matching panel 1's status line. The mock data is labeled 'Demo' so users can distinguish simulated devices from real ones."}, {"id": "docs_iphone_import_floor_plan", "label": "Import a Floor Plan File\u2026", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 4, under HOME", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import is offered but the helper copy states the primary path is authoring on the Mac, so the phone stays a controller and the Mac owns geometry editing."}, {"id": "docs_iphone_mac_pairing", "label": "Pair with Mac / Cross-Device Home Sync", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 4, MAC section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architectural decision visible in copy: the floor plan, rooms, lamps and device links are drawn in the House Control Mac app and synced to the phone after pairing, staying up to date. The phone is a thin client for home topology."}, {"id": "docs_iphone_smart_life_integration", "label": "Smart Life / Tuya Smart Integration", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 4, SMART LIFE section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signing in with a Smart Life or Tuya Smart account binds the lamps and air conditioners already linked in that floor plan to real hardware, replacing simulated devices. Third-party account linking is the bridge from demo to physical control."}, {"id": "docs_iphone_simulated_devices", "label": "Simulated Devices Mode", "file_type": "image", "source_file": "docs/iphone.png", "source_location": "panel 4, SMART LIFE section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Devices are simulated until a Smart Life/Tuya account is connected, letting the whole app be explored (including scene presets and the 3D scene) without hardware."}, {"id": "docs_iphone_ambient_dark_design_system", "label": "Ambient Dark Design System (amber = on, blue = primary, glow fills)", "file_type": "rationale", "source_file": "docs/iphone.png", "source_location": "all panels", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistent visual language across the four screens: near-black background, soft dark cards, amber for 'on'/warm-light state, blue for primary action and selection, large thin-weight numerals for the value being controlled, and glow behind active scene lights. The color semantics do the state communication that labels would otherwise need."}], "edges": [{"source": "docs_iphone_house_control_app", "target": "docs_iphone_home_overview_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": null, "weight": 1.0}, {"source": "docs_iphone_house_control_app", "target": "docs_iphone_living_ac_detail_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": null, "weight": 1.0}, {"source": "docs_iphone_house_control_app", "target": "docs_iphone_tv_backlight_detail_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": null, "weight": 1.0}, {"source": "docs_iphone_house_control_app", "target": "docs_iphone_settings_sheet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": null, "weight": 1.0}, {"source": "docs_iphone_home_overview_screen", "target": "docs_iphone_status_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1 top bar", "weight": 1.0}, {"source": "docs_iphone_home_overview_screen", "target": "docs_iphone_floor_plan_3d_scene", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1 upper half", "weight": 1.0}, {"source": "docs_iphone_home_overview_screen", "target": "docs_iphone_scene_presets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1", "weight": 1.0}, {"source": "docs_iphone_home_overview_screen", "target": "docs_iphone_room_filter_chips", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1", "weight": 1.0}, {"source": "docs_iphone_home_overview_screen", "target": "docs_iphone_whole_home_actions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1", "weight": 1.0}, {"source": "docs_iphone_home_overview_screen", "target": "docs_iphone_lighting_control_cards", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1 Living section", "weight": 1.0}, {"source": "docs_iphone_room_filter_chips", "target": "docs_iphone_lighting_control_cards", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 1: room chips scope the card list", "weight": 1.0}, {"source": "docs_iphone_lighting_control_cards", "target": "docs_iphone_living_ac_detail_screen", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/iphone.png", "source_location": "panel 1 'Living AC' card -> panel 2 detail screen", "weight": 1.0}, {"source": "docs_iphone_lighting_control_cards", "target": "docs_iphone_tv_backlight_detail_screen", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/iphone.png", "source_location": "panel 1 'TV backlight 70%' card -> panel 3 detail screen", "weight": 1.0}, {"source": "docs_iphone_living_ac_detail_screen", "target": "docs_iphone_temperature_slider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 2", "weight": 1.0}, {"source": "docs_iphone_living_ac_detail_screen", "target": "docs_iphone_eco_mode_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 2", "weight": 1.0}, {"source": "docs_iphone_living_ac_detail_screen", "target": "docs_iphone_ac_feature_dials", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 2", "weight": 1.0}, {"source": "docs_iphone_living_ac_detail_screen", "target": "docs_iphone_floor_plan_3d_scene", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 2 upper half", "weight": 1.0}, {"source": "docs_iphone_tv_backlight_detail_screen", "target": "docs_iphone_brightness_slider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 3", "weight": 1.0}, {"source": "docs_iphone_tv_backlight_detail_screen", "target": "docs_iphone_colour_picker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 3", "weight": 1.0}, {"source": "docs_iphone_tv_backlight_detail_screen", "target": "docs_iphone_floor_plan_3d_scene", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 3 upper half", "weight": 1.0}, {"source": "docs_iphone_brightness_slider", "target": "docs_iphone_colour_picker", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/iphone.png", "source_location": "panel 3: brightness fill adopts the selected colour", "weight": 1.0}, {"source": "docs_iphone_settings_sheet", "target": "docs_iphone_home_switcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 4 HOME section", "weight": 1.0}, {"source": "docs_iphone_settings_sheet", "target": "docs_iphone_import_floor_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 4", "weight": 1.0}, {"source": "docs_iphone_settings_sheet", "target": "docs_iphone_mac_pairing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 4 MAC section", "weight": 1.0}, {"source": "docs_iphone_settings_sheet", "target": "docs_iphone_smart_life_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 4 SMART LIFE section", "weight": 1.0}, {"source": "docs_iphone_settings_sheet", "target": "docs_iphone_simulated_devices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 4 SMART LIFE section", "weight": 1.0}, {"source": "docs_iphone_home_switcher", "target": "docs_iphone_status_header", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/iphone.png", "source_location": "selected Apartment home (5 rooms) matches 'Home' status header", "weight": 1.0}, {"source": "docs_iphone_home_switcher", "target": "docs_iphone_mac_pairing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/iphone.png", "source_location": "panel 4: paired Mac homes become entries in the switcher", "weight": 1.0}, {"source": "docs_iphone_mac_pairing", "target": "docs_iphone_floor_plan_3d_scene", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png", "source_location": "panel 4 copy: floor plan drawn on the Mac arrives on the phone", "weight": 1.0}, {"source": "docs_iphone_mac_pairing", "target": "docs_