location": "selected 'Cozy' preset uses blue outline while its effect is warm amber in the scene", "weight": 1.0}, {"source": "docs_iphone_ambient_dark_design_system", "target": "docs_iphone_colour_picker", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/iphone.png", "source_location": "accent follows emitted light colour on panel 3", "weight": 1.0}, {"source": "docs_iphone_status_header", "target": "docs_iphone_whole_home_actions", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/iphone.png", "source_location": "both report/act on the same 6-of-11 lights-on count", "weight": 1.0}, {"source": "docs_iphone_scene_presets", "target": "docs_iphone_whole_home_actions", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/iphone.png", "source_location": "both are whole-home bulk controls", "weight": 1.0}], "hyperedges": [{"id": "iphone_home_control_flow", "label": "Whole-Home Control Flow (status header, scene presets, room filters, device cards, 3D scene)", "nodes": ["docs_iphone_status_header", "docs_iphone_scene_presets", "docs_iphone_room_filter_chips", "docs_iphone_lighting_control_cards", "docs_iphone_floor_plan_3d_scene"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png"}, {"id": "iphone_device_detail_pattern", "label": "Shared Device Detail Pattern (AC and TV backlight screens)", "nodes": ["docs_iphone_living_ac_detail_screen", "docs_iphone_temperature_slider", "docs_iphone_tv_backlight_detail_screen", "docs_iphone_brightness_slider", "docs_iphone_colour_picker", "docs_iphone_ac_feature_dials"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/iphone.png"}, {"id": "iphone_home_provisioning", "label": "Home Provisioning: floor plan import, Mac pairing, Smart Life account, simulated devices", "nodes": ["docs_iphone_home_switcher", "docs_iphone_import_floor_plan", "docs_iphone_mac_pairing", "docs_iphone_smart_life_integration", "docs_iphone_simulated_devices"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/iphone.png"}]}