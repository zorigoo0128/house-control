{"nodes": [{"id": "docs_editor_editor_window", "label": "House Control Edit Home window", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single macOS window combines a spatial floor-plan canvas with list-based and numeric inspectors so one plan can be edited both by dragging and by typing exact values."}, {"id": "docs_editor_room_list", "label": "Rooms sidebar with dimensions", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rooms are listed with name and size (Living 6.4 x 4.6 m, Dining, Kitchen, Bedroom, Bathroom) so a room can be selected and edited without hunting for it on the plan; the add button supports drawing new rooms."}, {"id": "docs_editor_lights_list", "label": "Lights sidebar grouped by room and type", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each light is named with its room and kind (Living - ceiling, Living - floor, Living - strip, Kitchen - spots, Bedroom - table, Bathroom - mirror) rather than by device id, keeping the plan human-readable and mapping fixtures to Smart Life device capabilities."}, {"id": "docs_editor_ac_list", "label": "Air conditioners section", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Air conditioners get their own list below lights because they are placed as room-level units with their own device linking, not as lamps."}, {"id": "docs_editor_smart_life_demo_mode", "label": "Smart Life demo mode badge", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demo mode lets the owner design and preview a complete home before any Smart Life account is linked, so editing never blocks on OAuth or device discovery."}, {"id": "docs_editor_plan_canvas_2d", "label": "2D floor-plan editing canvas", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The top-down plan is the authoring surface: rooms, furniture, lamps and ACs are direct-manipulation objects on a dark grid, with room names and metre dimensions overlaid so geometry stays legible while dragging."}, {"id": "docs_editor_fixture_markers", "label": "Light, strip and opening markers on the plan", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round orange dots mark point lamps while short colored bars along walls mark strip lights and wall openings; color and shape encode fixture kind at a glance. Exact meaning of the blue versus orange bars is not stated in the screenshot."}, {"id": "docs_editor_3d_preview", "label": "Isometric 3D preview with Lights on toggle", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lit isometric cutaway validates that the 2D plan reads as a believable home and previews the lighting result before applying, without leaving the editor."}, {"id": "docs_editor_home_inspector", "label": "Home global settings inspector", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan-wide values are kept in a dedicated Home inspector rather than on individual objects, so a selected room or lamp edits only its own properties."}, {"id": "docs_editor_building_settings", "label": "Building dimensions and outdoor temperature", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wall height 2.6 m, inner wall thickness 1.25 m and outdoor temperature 29 C drive the 3D geometry and the thermal context shown by the panel; they are metre/second-order physical facts, not per-object styling."}, {"id": "docs_editor_default_camera", "label": "Default camera azimuth and elevation", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Azimuth 34 deg and elevation 47 deg define the default view. Walls facing the camera are cut away, so azimuth decides which side of the home is left open; exposing both as numbers makes the cutaway predictable instead of accidental."}, {"id": "docs_editor_save_and_apply", "label": "Save & apply action", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edits stay staged until Save & apply, which writes the plan to disk and reloads the menu bar panel, so the running panel can never disagree with what the editor shows. It is the primary blue action, separated from Undo/Redo and Import/Export."}, {"id": "docs_editor_undo_redo", "label": "Undo and Redo controls", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct manipulation of a whole home is easy to get wrong, so edits are reversible in-session before the explicit Save & apply commit."}, {"id": "docs_editor_import_export", "label": "Import and Export plan controls", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plan is a portable JSON document, so import/export lets a home be backed up, shared, or edited elsewhere instead of being trapped in app storage."}, {"id": "docs_editor_snap_to_grid", "label": "5 cm snap-to-grid editing", "file_type": "concept", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything snaps to 5 cm while dragging rooms, lamps and furniture and while resizing a room from its corner. Snapping keeps walls and furniture aligned and prevents slow coordinate drift, at the cost of sub-5 cm precision that a home plan does not need."}, {"id": "docs_editor_status_bar", "label": "Editor status bar summary", "file_type": "image", "source_file": "docs/editor.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The footer reports 5 rooms, 11 lights, 2 ACs and 0 linked to Smart Life, making integration coverage visible while editing instead of only after opening the panel."}], "edges": [{"source": "docs_editor_editor_window", "target": "docs_editor_room_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/editor.png", "source_location": null, "weight": 1.0}, {"source": "docs_editor_editor_window", "target": "docs_editor_lights_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/editor.png", "source_location": null, "weight": 1.0}, {"source": "docs_editor_editor_window", "target": "docs_editor_ac_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/editor.png", "source_location": null, "weight": 1.0}, {"source": "docs_editor_editor_window", "target": "docs_editor_plan_canvas_2d", "relation": "references", "confidence": "EXTRACTE