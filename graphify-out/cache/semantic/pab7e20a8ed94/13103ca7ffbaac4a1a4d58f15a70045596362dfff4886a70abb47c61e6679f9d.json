{"nodes": [{"id": "docs_connections_house_control_editor", "label": "House Control \u2014 Edit Home (desktop editor screen)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-column desktop layout: entity inventory on the left, spatial floor-plan canvas in the middle, integration/connection panel on the right. The screen answers 'where do my real devices live?' while the plan is being edited, so device binding is visible during layout work instead of in a separate settings flow."}, {"id": "docs_connections_home_settings_sidebar", "label": "Home Settings sidebar (rooms, lights, air conditioners inventory)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat, grouped, count-badged list (Rooms 5, Lights 11, Air conditioners 2) with inline add buttons; each light row shows its room\u00b7mount binding plus a link glyph when the entity is bound to a real device. Chosen over a tree because the list doubles as the canvas' object palette."}, {"id": "docs_connections_floor_plan_canvas", "label": "2D floor plan canvas (Bedroom, Bathroom, Kitchen, Living, Dining)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grid-backed plan with rooms as filled blocks, furniture as outlined shapes and lights as colored discs (blue = window/strip highlights, orange = warm lamps, green = connected lamp). Selection and connection state are signaled by color directly on the geometry rather than in a side list."}, {"id": "docs_connections_3d_preview", "label": "Isometric 3D room preview with 'Lights on' toggle", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live lit render of the same plan gives immediate feedback on lamp placement and light temperature, which a flat 2D plan cannot convey."}, {"id": "docs_connections_connections_panel", "label": "Connections panel \u2014 'Where your real lamps and air conditioners live'", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One card per smart-home ecosystem, each showing a capability sentence, a status line (green check + hub name + device count, amber 'Not connected', or an action prompt) and a chevron for drill-down. Status is expressed in words, not only color, so the panel is readable and scannable."}, {"id": "docs_connections_integration_cards", "label": "Integration provider card pattern", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniform card anatomy (brand icon tile, title, one-line description, status footer, chevron) lets new providers be added without redesigning the panel; the footer is the only varying region."}, {"id": "docs_connections_smart_life", "label": "Smart Life (Tuya) integration", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_home_assistant", "label": "Home Assistant integration", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_philips_hue", "label": "Philips Hue integration (Hue Bridge, no account needed)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_apple_home", "label": "Apple Home integration (HomeKit / Matter via iPhone)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_matter_protocol", "label": "Matter protocol", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_zigbee_protocol", "label": "Zigbee protocol", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_homekit_protocol", "label": "HomeKit", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_connections_room_inventory", "label": "Room inventory (5 rooms with metric dimensions)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rooms carry width \u00d7 depth in metres in both the sidebar and the plan, making the list the source of truth for area and the canvas a projection of it."}, {"id": "docs_connections_light_inventory", "label": "Light inventory (11 lights listed as room \u00b7 mount)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lights are identified physically ('Bedroom \u00b7 table', 'Kitchen \u00b7 strip') rather than by smart-home device name, so the plan stays authoritative and providers are only a binding layer."}, {"id": "docs_connections_light_room_mount_binding", "label": "Light \u2192 room \u00b7 mount binding notation", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Living \u00b7 ceiling' composes the physical location as a two-part key; the same key is legible on the plan and in the device list, so binding a real lamp never requires renaming the plan object."}, {"id": "docs_connections_status_bar", "label": "Footer status bar (5 rooms \u00b7 11 lights \u00b7 2 ACs \u00b7 3 linked to real devices)", "file_type": "image", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live aggregate gives the coverage of real-device linking at a glance, which is the screen's core metric (3 of 13 controllable entities linked)."}, {"id": "docs_connections_save_and_apply", "label": "Save & apply action", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing is staged as a draft and committed explicitly; Import\u2026/Export\u2026 sit beside it for file-based plan exchange, keeping destructive or device-affecting writes behind a single primary button."}, {"id": "docs_connections_undo_redo_history", "label": "Undo / Redo history", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural edits (drag, resize) are frequent and cheap to misfire, so reversible history is offered before Save & apply instead of confirmation dialogs."}, {"id": "docs_connections_snap_to_grid", "label": "5 cm snap-to-grid editing", "file_type": "concept", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan geometry snaps to 5 cm and rooms resize from a corner, keeping dimensions plausible against real-world measurements without a numeric-entry form."}, {"id": "docs_connections_three_column_dark_layout", "label": "Dark three-column editor layout", "file_type": "rationale", "source_file": "docs/connections.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark chrome recedes so the illuminated floor plan and light colors carry the visual weight; the fixed left/right rails keep inventory and device status persistent while the canvas pans and zooms."}], "edges": [{"source": "docs_connections_house_control_editor", "target": "docs_connections_home_settings_sidebar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connections.png", "source_location": null, "weight": 1.0}, {"source": "docs_connections_house_control_editor", "target": "docs_connections_floor_plan_canvas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connections.png", "source_location": null, "weight": 1.0}, {"source": "docs_connections_house_control_editor", "target": "docs_connections_connections_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connections.png", "source_location": null, "weight": 1.0}, {"source": "docs_connections_house_control_editor", "target": "docs_connections_3d_preview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connections.png", "source_location": null, "weight": 1.0}, {"source": "docs_connections_house_control_editor", "target": "docs_connections_three_column_dark_layout", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/connections.png", "source_location": null, "weight": 1.0}, {"source": "docs_connections_