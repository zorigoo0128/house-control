{"nodes": [{"id": "changelog_release_1_1_1", "label": "Release 1.1.1 (2026-10-18)", "file_type": "document", "source_file": "CHANGELOG.md"}, {"id": "changelog_release_1_1_0", "label": "Release 1.1.0 (2026-10-18)", "file_type": "document", "source_file": "CHANGELOG.md"}, {"id": "changelog_release_1_0_0", "label": "Release 1.0.0 (2026-10-15)", "file_type": "document", "source_file": "CHANGELOG.md"}, {"id": "changelog_release_0_1_0", "label": "Release 0.1.0 (2026-10-14)", "file_type": "document", "source_file": "CHANGELOG.md"}, {"id": "changelog_light_groups", "label": "Light Groups", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "A control shortcut rather than a device: a lamp keeps its own state and may sit in any number of groups; a control reaches only the lamps that can do it, so a plain plug switches with the rest and keeps its brightness."}, {"id": "changelog_scene_full_editing", "label": "Full Scene Editing", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "A scene no longer only switches things on and off: each light takes brightness, colour temperature and colour and each AC a target, mode and fan, chosen in the scene's form."}, {"id": "changelog_capture_preview_scene", "label": "Capture What the Preview Shows", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "The editor's 3D preview is tappable and the whole look can be written into the scene being edited, so building a scene is done by lighting the home rather than filling in fields."}, {"id": "changelog_open_at_login", "label": "Open at Login", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "Implemented as the app's entry under System Settings' Login Items, so the system owns the switch and the login item follows the app when it is moved."}, {"id": "changelog_two_iphone_editions", "label": "Two iPhone Editions", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "Smart Life lives in its own module (HouseSmartLife) linked only by the Mac app and the Smart Life edition, so the App Store edition never contains the unsupported Tuya interface."}, {"id": "changelog_bonjour_types_fix", "label": "Bonjour Types Must Be Declared", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "iOS only browses the Bonjour types an app declares, so Hue Bridges and Home Assistant servers were never found until _hue._tcp and _home-assistant._tcp were added to NSBonjourServices."}, {"id": "changelog_widget_state_queue_fix", "label": "Widget State Regression Fix", "file_type": "concept", "source_file": "CHANGELOG.md", "rationale": "Widgets could jump back to an older state when the app started with widget taps still queued; the queue is now applied against the current snapshot."}], "edges": [{"source": "changelog_release_1_1_1", "target": "changelog_light_groups", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "weight": 1.0}, {"source": "changelog_release_1_1_1", "target": "changelog_scene_full_editing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "weight": 1.0}, {"source": "changelog_release_1_1_1", "target": "changelog_capture_preview_scene", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "weight": 1.0}, {"source": "changelog_release_1_1_0", "target": "changelog_open_at_login", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "weight": 1.0}, {"source": "changelog_release_1_0_0", "target": "changelog_two_iphone_editions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "weight": 1.0}, {"source": "changelog_release_1_0_0", "target": "changelog_bonjour_types_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "wei